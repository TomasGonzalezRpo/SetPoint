# Copia este archivo como .env y llena los valores. NUNCA subas .env a git.

# --- Supabase (Settings → API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# --- Google OAuth (Google Cloud → Google Auth Platform → Clients) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev (solo backend):   http://localhost:8000/api/auth/callback
# Dev (con frontend):   http://localhost:5173/api/auth/callback
# Producción:           https://<tu-app>.vercel.app/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Sesión ---
# Mínimo 32 caracteres. Genera uno: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_DAYS=30
# Correos con acceso (separados por coma)
ALLOWED_EMAILS=tu-correo@gmail.com

# --- Frontend ---
# Dev (solo backend): http://localhost:8000   |  Dev con frontend: http://localhost:5173
# Producción: https://<tu-app>.vercel.app  (con https las cookies se marcan Secure solas)
FRONTEND_URL=http://localhost:8000
